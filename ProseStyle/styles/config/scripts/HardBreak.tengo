text := import("text")

// A line that starts something other than a paragraph continuation.
not_prose := func(line) {
	return line == "" ||
		text.has_prefix(line, "#") ||
		text.has_prefix(line, "|") ||
		text.has_prefix(line, "<") ||
		text.has_prefix(line, ">") ||
		text.has_prefix(line, "```") ||
		text.has_prefix(line, "~~~") ||
		text.has_prefix(line, "---") ||
		text.re_match(`^\[[^\]]+\]:`, line) ||
		text.re_match(`^(?:[-*+]|\d+[.)])\s`, line)
}

lines := text.split(scope, "\n")
matches := []
offset := 0
in_fence := false
in_front := false
for i := 0; i < len(lines); i += 1 {
	raw := lines[i]
	line := text.trim_space(raw)
	if i == 0 && line == "---" {
		in_front = true
	} else if in_front {
		if line == "---" {
			in_front = false
		}
	} else if text.has_prefix(line, "```") || text.has_prefix(line, "~~~") {
		in_fence = !in_fence
	} else if !in_fence && line != "" && !text.has_prefix(line, "#") &&
		!text.has_prefix(line, "|") && !text.has_prefix(line, "<") &&
		!text.has_prefix(line, ">") && !text.has_prefix(line, "---") &&
		!text.re_match(`^\[[^\]]+\]:`, line) && i + 1 < len(lines) {
		next := text.trim_space(lines[i + 1])
		continues := !not_prose(next)
		broken := text.has_suffix(raw, "  ") || text.has_suffix(raw, "\\")
		if continues && !broken {
			matches = append(matches, {begin: offset, end: offset + len(raw)})
		}
	}
	offset += len(raw) + 1
}
