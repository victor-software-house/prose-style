text := import("text")

// Reads the file once, line by line, so the cost grows with its length.
// Fenced blocks and front matter are skipped. On other lines, code spans and
// link text are masked with spaces of the same length, so offsets stay true.

// The same run of spaces as the matched text, to mask it in place.
blank := func(s) {
	return text.repeat(" ", len(s))
}

// Masks each match of pattern in line.
mask := func(pattern, line) {
	out := ""
	last := 0
	found := text.re_find(pattern, line, -1)
	if found == undefined {
		return line
	}
	for m in found {
		out += line[last:m[0].begin] + blank(m[0].text)
		last = m[0].end
	}
	return out + line[last:]
}

// A code span closes with a run of the same length; a link's text sits in
// brackets right before ( or [.
spans := "```.*?```|``.*?``|`[^`]*`"
links := `\[[^\]]*\][(\[]`

codes := `#\d{2,5}|![1-9]\d{1,4}|[A-Z][A-Z0-9]{1,6}-\d{2,5}`
standard := `^(?:SHA|UTF|ISO|RFC|CVE|AES|TLS|HTTP|DNS|UTC|GMT|IPv|W)-`

matches := []
offset := 0
in_fence := false
in_front := false
number := 0
for raw in text.split(scope, "\n") {
	line := text.trim_space(raw)
	number += 1
	if number == 1 && line == "---" {
		in_front = true
	} else if in_front {
		if line == "---" {
			in_front = false
		}
	} else if text.has_prefix(line, "```") || text.has_prefix(line, "~~~") {
		in_fence = !in_fence
	} else if !in_fence {
		body := mask(links, mask(spans, raw))
		found := text.re_find(codes, body, -1)
		if found != undefined {
			for m in found {
				b := m[0].begin
				e := m[0].end
				before := b > 0 ? body[b-1:b] : " "
				after := e < len(body) ? body[e:e+1] : " "
				if !text.re_match("[\\[\\w/`#&-]", before) && !text.re_match("[\\w\\]`-]", after) && !text.re_match(standard, m[0].text) {
					matches = append(matches, {begin: offset + b, end: offset + e})
				}
			}
		}
	}
	offset += len(raw) + 1
}
