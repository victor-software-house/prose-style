text := import("text")

// A line that is not running prose: heading, table row, HTML, a link
// definition, a thematic break or a blockquote.
not_prose := func(line) {
	return line == "" ||
		text.has_prefix(line, "#") ||
		text.has_prefix(line, "|") ||
		text.has_prefix(line, "<") ||
		text.has_prefix(line, ">") ||
		text.has_prefix(line, "---") ||
		text.re_match(`^\[[^\]]+\]:`, line)
}

matches := []
offset := 0
in_fence := false
in_front := false
number := 0
for raw in text.split(scope, "\n") {
	line := text.trim_space(raw)
	number += 1
	if number == 1 && line == "---" {
		in_front = true
	} else if in_front {
		if line == "---" {
			in_front = false
		}
	} else if text.has_prefix(line, "```") || text.has_prefix(line, "~~~") {
		in_fence = !in_fence
	} else if !in_fence && !not_prose(line) {
		// Drop the list marker, code spans, link targets and abbreviations,
		// then look for a sentence end followed by a capital.
		body := text.re_replace(`^(?:[-*+]|\d+[.)])\s+`, line, "")
		body = text.re_replace("`[^`]*`", body, "X")
		body = text.re_replace(`\]\([^)]*\)`, body, "]")
		body = text.re_replace(`\b(?:e\.g|i\.e|vs|etc|cf|Dr|Mr|Ms|Mrs|No|approx)\.`, body, "X")
		if text.re_match(`[.!?]["')\]*_]*\s+["(\[*_]*[A-Z]`, body) {
			matches = append(matches, {begin: offset, end: offset + len(raw)})
		}
	}
	offset += len(raw) + 1
}
