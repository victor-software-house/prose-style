text := import("text")

// Three prepositions, each at most two words after the last, form a chain.
// A comma, semicolon, colon, dash, parenthesis or code span ends a chain:
// Vale masks a code span as a run of asterisks.

preps := {}
for p in ["of", "in", "on", "at", "for", "with", "from", "by", "into", "onto", "over", "under", "through", "across", "between", "within", "without", "about", "against", "during", "after", "before"] {
	preps[p] = true
}

matches := []
count := 0
start := 0
gap := 0
found := text.re_find(`[A-Za-z][\w'-]*|\*+|[,;:()—–]`, scope, -1)
if found != undefined {
	for m in found {
		word := m[0].text
		if !text.re_match(`^[A-Za-z]`, word) {
			count = 0
		} else if preps[text.to_lower(word)] {
			if count > 0 && gap <= 2 {
				count += 1
			} else {
				count = 1
				start = m[0].begin
			}
			gap = 0
			if count == 3 {
				matches = append(matches, {begin: start, end: m[0].end})
				count = 0
			}
		} else {
			gap += 1
			if gap > 2 {
				count = 0
			}
		}
	}
}
